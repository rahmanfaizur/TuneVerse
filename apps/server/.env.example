# Copy to .env for local development. In production, set these on your host instead.

# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=
DATABASE_URL=

# Required in production. Comma-separated if there's more than one frontend URL.
CORS_ORIGIN=http://localhost:3000

# Optional. Where Spotify logins return to. Defaults to the first CORS_ORIGIN.
CLIENT_URL=

# Optional. Without these the app still runs, but Spotify login will fail.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/spotify/callback

# Optional. Song recommendations use Gemini first, then fall back to Hugging Face.
GOOGLE_API_KEY=
HF_TOKEN=
